# --- 5. Security, Admin Passkey & Google Analytics ---
ADMIN_SECRET=
GA_MEASUREMENT_ID=G-P6M5JYSKP0
GOOGLE_ANALYTICS_ID=G-P6M5JYSKP0
NODE_ENV=production
